<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Mirrors src/main/resources/logback-spring.xml, plus one test-only pattern without a capture group -->
    <!-- so that the whole-match masking branch is exercised (test coverage) -->
    
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="structuredFormat" source="logging.structured.format.console"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <encoder class="com.miguelbf.exchangerateapi.config.logging.MaskingStructuredLogEncoder">
            <format>${CONSOLE_LOG_STRUCTURED_FORMAT}</format>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
            <!-- Prod Masking rules -->
            <maskPattern>access_key=(.{32})</maskPattern>
            <!-- Test-only: no capture group, so the whole match is masked -->
            <maskPattern>secret-[a-z0-9]{8}</maskPattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>